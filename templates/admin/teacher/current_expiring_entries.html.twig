{% set allQueryParams = app.request.query.all() %}

{# 2. Extrahiere die bestehenden Filter (oder leeres Array, wenn nicht vorhanden) #}
{% set currentFilters = allQueryParams['filters'] ?? {} %}

{# 3. Füge den teacher-Filter hinzu #}
{% set filterParams = currentFilters | merge({
    'teacher': {
        'comparison': '=',
        'value': entity.instance.id
    },
    'incidentDateMonth' : "now"|date('n'),
    'incidentDateYear' : "now"|date_modify('-1 year')|date('Y'),
}) %}

{% set filterParamsNew = {
    'teacher': {
        'comparison': '=',
        'value': entity.instance.id
    }
} %}

{% set myActionUrl = ea_url()
    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
    .setAction('index')
    .set('filters', filterParams)
%}

{% set allEntriesUrl = ea_url()
    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
    .setAction('index')
    .set('filters', filterParamsNew)
%}

{% set exportActionUrl = ea_url()
    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
    .setAction('exportExcel')
    .set('filters', filterParams)
%}

<div class="">
    <div class="d-flex gap-3 align-items-center justify-content-between">
        <div class="field-text form-group">
            <label class="form-control-label" for="expiring-select">Auszugleichen bis Ende des Monats</label>
            <div class="form-widget">
                <div class="d-flex gap-3 align-items-center">
                    <div>
                        <input id="expiring-select" class="form-control form-control-sm" name="debutat" readonly value="{{ field.value }}">
                    </div>
                    <div class="btn-group">
                        <a href="{{ myActionUrl }}" class="btn btn-secondary"><i class="ti ti-eye tk-text-primary"></i>Anzeigen</a>
                        <a href="{{ exportActionUrl }}" class="btn btn-secondary"><i class="ti ti-file-type-xls text-success"></i>Exportieren</a>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-3 align-items-center">
            </div>
        </div>
    </div>
</div>



