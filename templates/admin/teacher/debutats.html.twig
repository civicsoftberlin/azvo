{% set myActionUrl = ea_url()
    .setController('App\\Controller\\Admin\\TeacherCrudController')
    .setAction('exportExcel')
%}

{% set filterParams = {
    'teacher': {
        'comparison': '=',
        'value': entity.instance.id
    }
} %}

{% set viewDebutatActionUrl = ea_url()
    .setController('App\\Controller\\Admin\\TeacherDebutatCrudController')
    .setAction('index')
    .set('filters', filterParams)
%}




        {# Select mit Autocomplete #}
        <form class="w-100" action="{{ myActionUrl }}" method="post">
            <div class="d-flex gap-3 align-items-center justify-content-between w-100">
                <div class="field-association form-group">
                    <label class="form-control-label" for="export-select">Auszugleichen bis Ende des Monats</label>
                    <div class="form-widget">
                        <div class="d-flex gap-3 align-items-center">
                            <div>
                                <select id="export-select" class="form-select form-select-sm" name="debutat" required="required" data-placeholder="Schuljahr auswählen...">
                                    <option value="" selected>Schuljahr auswählen ...</option>
                                    {% for debutat in field.value %}
                                        <option value="{{ debutat.id }}">
                                            {{ debutat.validFrom|date('d.m.Y') }} - {{ debutat.invalidFrom|date_modify('-1 day')|date('d.m.Y') }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit" id="" class="btn btn-secondary"><i class="ti ti-file-type-xls text-success"></i>Exportieren</button>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <label for="debutat-select" class="d-none"></label>
                    <input type="hidden" name="_token" value="{{ csrf_token('export-debutat') }}">
                    <a href="{{ viewDebutatActionUrl }}" class="btn btn-secondary"><i class="ti ti-settings tk-text-primary"></i>Stundendeputat verwalten</a>
                </div>
            </div>
        </form>


