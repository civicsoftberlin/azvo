{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block content_title %}
    Stundenkonto
    <div class="ms-3 d-inline-block">
        <label>
            {# Basis-URL ohne Teacher-Filter erstellen #}
            {% set allQueryParams = app.request.query.all() %}
            {% set currentFilters = allQueryParams['filters'] ?? {} %}
            {% set filterParams = currentFilters
                | filter((value, key) => key != 'teacher')%}
            {% set viewUrl = ea_url()
                .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                .setAction('index')
                .set('filters', filterParams)
            %}
            {% set baseUrl = ea_url().unset('filters[teacher]') %}

            <select class="form-select form-select-sm tk-border-primary rounded-3"
                    style="width: auto; min-width: 180px;"
                    onchange="if(this.value) { window.location.href = this.value; } else {
                        window.location.href = '{{ baseUrl }}';
                        }">

                {# Option "Alle Lehrkräfte" (Reset) - nutzt die saubere Basis-URL #}
                <option value="{{ viewUrl }}"
                        {% if app.request.query.all('filters')['teacher'] is not defined %}selected{% endif %}>
                    Alle Lehrkräfte
                </option>

                {# Lehrkräfte-Optionen - alle bauen auf der sauberen Basis-URL auf #}
                {% for teacher in teachers|sort((a, b) => a.shortName <=> b.shortName) %}
                    <option value="{{ baseUrl.set('filters[teacher][value]', teacher.id).set('filters[teacher][comparison]', '=') }}"
                            {% if app.request.query.all('filters')['teacher']['value'] is defined and app.request.query.all('filters')['teacher']['value'] == teacher.id %}selected{% endif %}>
                        {{ teacher.shortName }}
                    </option>
                {% endfor %}
            </select>
        </label>
    </div>
    <div class="ms-2 d-inline-block me-auto tk-text-primary d-flex align-items-center">
        {% if current_date is defined %}
            {% set allQueryParams = app.request.query.all() %}
            {% set currentFilters = allQueryParams['filters'] ?? {} %}
            {% set filterParams = currentFilters
                | filter((value, key) => key != 'incidentDateDay')
                 %}
            {% set viewUrl = ea_url()
                .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                .setAction('index')
                .set('filters', filterParams)
            %}
            <div class="input-group input-group-sm">
                <input type="text" readonly class="form-control tk-border-primary rounded-start-3" value="{{ current_date|default(0) ? current_date|date('d.m.Y') : '' }}">
                <a href="{{ viewUrl }}" class="rounded-start-0 btn btn-primary tk-border-primary"><i class="ti ti-x text-primary"></i></a>
            </div>


        {% endif %}
    </div>
{% endblock %}

{% block page_actions %}



    {% if filters|length > 0 %}
        <div class="datagrid-filters">
            {% block filters %}
                {{ parent() }}
            {% endblock filters %}
        </div>
    {% endif %}

    {% block sort_actions %}
        {{ parent() }}
    {% endblock sort_actions %}

    {% block global_actions %}
        {{ parent() }}
    {% endblock %}
{% endblock %}



{% block table_body %}
    {{ parent() }}
{% endblock %}

{% block table_footer %}
    <tfoot class="sticky-bottom table-info"  style="z-index: 920; bottom:50px">
    {% if entities|length > 0 %}
        {% set totalOvertime = 0 %}
        {% set totalEntries = 0 %}

        {# entities ist eine iterable von EntityDto Objekten #}
        {% for entityDto in entities %}
            {% set entry = entityDto.instance %}
            {% set totalOvertime = totalOvertime + entry.getAmount %}
        {% endfor %}
        <tr class="{{ totalOvertime > 0 ? 'is-warning' : (totalOvertime < 0 ? 'is-critical' : 'is-neutral') }}">
            <td  class="text-start">Anzahl</td>
            <td>
                <span class="">{{ entities|length }}</span>
            </td>
            <td colspan="7" class=""></td>
            <td  class="text-end">Virtuelles IST</td>
            <td>
                <span>
                    {{ totalOvertime|number_format(0, ',', '.') }}
                </span>
            </td>
            <td colspan="6" class="text-end"></td>
        </tr>
    {% endif %}
    </tfoot>
{% endblock %}
