{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block content_title %}
{{ page_title }}
{% endblock %}

{% block main %}

    {% set allQueryParams = app.request.query.all() %}

    {# 2. Extrahiere die bestehenden Filter (oder leeres Array, wenn nicht vorhanden) #}
    {% set currentFilters = allQueryParams['filters'] ?? {} %}
    <table id="" class="table table-custom datagrid align-middle">
        <thead>
        <tr class="">
            <th>ID</th>
            <th>Lehrkraft</th>
            <th class="">Ereignisdatum</th>
            <th class="">Klasse</th>
            <th class="text-end">Schulstunde</th>
            <th class="">Grund</th>
            <th class="">Untis-Kommentar</th>
            <th class="text-end">Stundendifferenz</th>
            <th class="text-end">Auszugleichen bis</th>
            <th class="text-end">Ausgeglichen am</th>
            <th class="text-end">Ausgeglichen durch ID</th>
            <th class="">Systemkommentar</th>
            <th class="text-end"></th>
        </tr>
        </thead>
        <tbody>
        {% for ote in other_entry %}
            {% set filterParams = currentFilters|merge({
                'teacher': {
                    'comparison': '=',
                    'value': ote.teacher.id
                },
                'incidentDateYear' : ote.incidentDate|date('Y'),
                'incidentDateMonth' : ote.incidentDate|date('n'),
            }) %}
            {% set viewUrl = ea_url()
                .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                .setAction('index')
                .set('filters', filterParams)
            %}
            {% set detailUrl = ea_url()
                .setController('App\\Controller\\Admin\\TeacherCrudController')
                .setAction('detail')
                .set('entityId', ote.teacher.id)
            %}
            {% if loop.index == 1 %}
            {% set detailRowUrl = ea_url()
                .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                .setAction('index')
                .set('filters', filterParams)
            %}
            {% else %}
                {% set detailRowUrl = ea_url()
                    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                    .setAction('detail')
                    .set('entityId', ote.id)
                    .set('filters', filterParams)
                %}
            {% endif %}
            {% set detailUrlB = ea_url()
                .setController('App\\Controller\\Admin\\TeacherCrudController')
                .setAction('detail')
                .set('entityId', ote.teacher.id)
            %}
            {% set exportUrl = ea_url()
                .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                .setAction('exportExcel')
                .set('filters', filterParams)
            %}


            <tr data-default-action-url="{{ detailRowUrl }}" role="link" tabindex="0" class="ea-clickable-row {% if loop.index == 1 %}fw-bold{% endif %}">
                <td>{{ ote.id }}</td>
                <td class=""><a href="{{ detailUrl }}">{{ ote.teacher.shortName }}</a></td>
                <td class="">{{ ote.incidentDate|date('d.m.Y') }}</td>
                <td class="">{{ ote.class }}</td>
                <td class="text-end">{{ ote.courseHour }}</td>
                <td class="">{{ ote.reason }}</td>
                <td class="">{{ ote.untisComment }}</td>
                <td class="text-end">{{ ote.amount }}</td>
                <td class="text-end">{{ ote.expiresAt ? ote.expiresAt|date('d.m.Y') : '' }}</td>
                <td class="text-end">{{ ote.invalidatedAt ? ote.invalidatedAt|date('d.m.Y') : '' }}</td>
                <td class="text-end">{{ ote.invalidatedBy }}</td>
                <td class="">{{ ote.comment }}</td>
                <td class="text-end actions">
                    <a href="{{ detailUrlB }}" class="btn btn-secondary "><i class="ti ti-school tk-text-primary"></i>
                        <span class="btn-label"><span class="action-label">Details</span></span>
                    </a>
                    <a href="{{ viewUrl }}" class="btn btn-secondary"><i class="ti ti-table tk-text-primary"></i>Stundenkonto</a>
                    <a href="{{ exportUrl }}" class="btn btn-secondary"><i class="ti ti-table-export text-success"></i>Monatsansicht exportieren</a>
                </td>
            </tr>
            {% if loop.index == 1 and other_entry|length > 1 %}
            <tr class="row-custom">
                <td  class="text-center text-muted" style="background-color: var(--body-bg)"></td>
                <td colspan="12" class="text-muted" style="background-color: var(--body-bg)"><i class="ti ti-arrow-big-down-lines me-2 tk-text-primary"></i>verknüpft mit folgenden Buchungen</td>
            </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>

    {% block detail_fields %}

    {% endblock detail_fields %}


    {% block delete_form %}
        {{ include('@EasyAdmin/crud/includes/_action_confirmation_modal.html.twig', with_context: false) }}
    {% endblock delete_form %}
{% endblock %}
