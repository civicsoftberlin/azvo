                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="tab-pane" id="tab-decay">
                <table id="" class="table table-custom datagrid align-middle">
                    <thead>
                    <tr>

                        <th style="width: 200px">Lehrkraft</th>
                        <th style="width: 200px" class="text-end bg-light-hover">Auszugleichen</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
