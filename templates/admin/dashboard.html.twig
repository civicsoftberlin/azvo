{#                            </div>#}
{#                        </div>#}
{#                    </div>#}
                </div>
            </div>
        </div>

    </div>

    <script type="module">
        import * as echarts from 'echarts';

        const timeData = {{ stat_ticks|json_encode|raw }};
        const mehrstunden = {{ stat_carryovers|json_encode|raw }};
        const minderstunden = {{ stat_decays|json_encode|raw }};
        const heatMapData = {{ stat_heatmap|json_encode|raw }};

        const chart = echarts.init(document.getElementById('my-chart'));
        const chart2 = echarts.init(document.getElementById('my-chart-2'));

        let heatMapItem = document.getElementById('heat-map')

        let heatMap = null;
        if (heatMapItem) {
            heatMap = echarts.init(heatMapItem);
        }

        chart.setOption({
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: true,
                    axisLine: { onZero: true },
                    data: timeData,
                    position: 'bottom'
                },
                {
                    gridIndex: 1,
                    type: 'category',
                    boundaryGap: true,
                    axisLine: { onZero: true },
                    data: timeData,
                    position: 'top'
                }
            ],
            yAxis: [
                {

                    type: 'value',
                },
                {
                    gridIndex: 1,

                    type: 'value',
                    inverse: true
                }
            ],
            axisPointer: {
                link: [
                    {
                        xAxisIndex: 'all'
                    }
                ]
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    animation: true
                },
                formatter: function (params) {
                    // Sortiere: yAxisIndex 0 (oben/Mehrstunden) zuerst
                    params.sort((a, b) => a.yAxisIndex - b.yAxisIndex);

                    let html = `<div style="font-weight:bold;margin-bottom:6px;">${params[0].axisValue}</div>`;
                    params.forEach(p => {
                        html += `<div style="display:flex;align-items:center;gap:8px;margin:4px 0;">
                <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${p.color};"></span>
                <span>${p.seriesName}</span>
                <span style="margin-left:auto;font-weight:bold;">${p.value}</span>
            </div>`;
                    });
                    return html;
                }
            },
            grid: [
                {
                    left: 50,
                    right: 50,
                    top: 10,
                    height: '35%'
                },
                {
                    left: 50,
                    right: 50,
                    top: '50%',
                    height: '35%'
                }
            ],
            series: [
                {
                    name: 'Mehrstunden',
                    type: 'line',
                    symbolSize: 8,
                    data: mehrstunden,
                    color: 'rgb(255, 191, 0)',
                    areaStyle: {
                        opacity: 0.3,
                        color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                            {
                                offset: 0,
                                color: 'rgb(255, 191, 0)'
                            },
                            {
                                offset: 1,
                                color: 'rgb(255, 191, 0)'
                            }
                        ])
                    },
                    emphasis: {
                        focus: 'series'
                    },
                },
                {
                    name: 'Minderstunden',
                    type: 'line',
                    xAxisIndex: 1,
                    yAxisIndex: 1,
                    symbolSize: 8,
                    data: minderstunden,
                    color: 'rgb(224, 62, 76)',
                    areaStyle: {
                        opacity: 0.3,
                        color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                            {
                                offset: 0,
                                color: 'rgb(224, 62, 76)'
                            },
                            {
                                offset: 1,
                                color: 'rgb(224, 62, 76)'
                            }
                        ])
                    },
                    emphasis: {
                        focus: 'series'
                    },
                }

            ]
        });

        chart2.setOption({
            xAxis: {
                type: 'category',
                data: ['Verfallen', 'Übertragen'],
                axisTick: {
                    alignWithLabel: true
                }
            },
            yAxis: {
                type: 'value'
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'shadow'
                }
            },
            grid: {
                top: 10,
                bottom: 5,
                left: 0,
                right: 0,
                containLabel: true
            },
            series: [
                {
                    data: [
                        {
                            value: {{ stat_real_decays }},
                            itemStyle: {
                                color: 'rgb(224, 62, 76)',
                            },
                        },
                        {
                            value: {{ stat_real_carryovers }},
                            itemStyle: {
                                color: 'rgb(255, 191, 0)',
                            },
                        },
                    ],

                    type: 'bar',
                    barWidth: '40%',
                }
            ]
        });

        const xCnt = 5;
        const yCnt = 10;

        if (heatMap) {
            heatMap.setOption({
                tooltip: {
                    position: 'top',
                    formatter: function (params) {
                        // params.value ist [x, y, value]
                        const days = ['Mo', 'Di', 'Mi', 'Do', 'Fr'];
                        // Dynamische Stunden-Beschriftung basierend auf y-Index
                        const hours = Array.from({length: 10}, (_, i) => `${i}. Stunde`);
                        return `${days[params.value[0]]}, ${hours[params.value[1]]}<br/>Ausfälle: <b>${params.value[2]}</b>`;
                    }
                },
                matrix: {
                    x: {
                        data: ['Mo', 'Di', 'Mi', 'Do', 'Fr'],
                        itemStyle: {
                            borderWidth: 0,
                        }
                    },
                    y: {
                        data: Array.from({length: 10}, (_, i) => {
                            return (i) + '. Stunde';
                        }),
                        itemStyle: {
                            borderWidth: 0,
                        }
                    },
                    top: 5,
                    bottom: 5,
                    left: 0,
                    right: 80,
                    backgroundStyle: {
                        borderWidth: 0,
                    },
                    body: {
                        itemStyle: {
                            borderWidth: 1,
                            borderColor: 'transparent', // gegen den Sub-Pixel-Artefakt-Trick
                        },
                    },
                },
                visualMap: {
                    type: 'continuous',
                    min: 1,
                    max: {{ stat_heatmap_max }},
                    dimension: 2,
                    calculable: true,
                    orient: 'vertical',
                    top: 'middle',
                    right: 0,
                    inRange: {
                        // ECharts verteilt diese Farben gleichmäßig über den Wertebereich (0 bis max)
                        color: [
                            'rgb(30, 211, 121)', // 25% (Grün)
                            'rgb(255, 191, 0)', // 50% (Gelb)
                            'rgb(224, 62, 76)'  // 100% (Dunkelrot)
                        ]
                    }
                },
                series: {
                    type: 'heatmap',
                    coordinateSystem: 'matrix',
                    data: heatMapData,
                    label: {
                        show: false,
                    },
                    itemStyle: {
                        borderWidth: 0,
                        borderColor: 'transparent',
                    },
                    emphasis: {
                        itemStyle: {
                            borderWidth: 0,
                            borderColor: 'transparent',
                        }
                    }
                }
            });
        }



        window.addEventListener('resize', () => chart.resize());
        window.addEventListener('resize', () => chart2.resize());
        window.addEventListener('resize', () => heatMap.resize());

        document.addEventListener('DOMContentLoaded', () => {
            chart.resize();
            chart2.resize();
            //heatMap.resize();
        });

        const tab = document.querySelector('#tablist-tab-chart')

        tab.addEventListener('click', event => {
            setTimeout(() => {
                chart.resize();
                chart2.resize();
                //heatMap.resize();
            }, 0);
        })

    </script>
{% endblock %}


