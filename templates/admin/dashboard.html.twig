            </div>

            <div class="tab-pane" id="tab-chart">
                <div class="row g-3 align-items-stretch">
                    <div class="col-8">
                        <div class="card card-body rounded-3 h-100" style="background: var(--sidebar-bg);border: var(--border-width) solid var(--main-content-border-color);">
                            <h5 class="card-title">Reine Mehr-/Minderstunden</h5>
                            <h6 class="card-subtitle mb-2 tk-text-primary">Letzte 12 Monate</h6>
                            <div class="ratio ratio-21x9">
                                <div id="my-chart"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card card-body rounded-3 h-100" style="background: var(--sidebar-bg);border: var(--border-width) solid var(--main-content-border-color);">
                            <h5 class="card-title">Stundenverfall und Überträge</h5>
                            <h6 class="card-subtitle mb-2 tk-text-primary">{{ "first day of this month"|date()|date_modify('-1 month')|format_datetime(date_format='none', time_format='none', locale='de', pattern='MMMM Y') }}</h6>
                            <div class="ratio h-100 w-100">
                                <div id="my-chart-2"></div>
                            </div>
                        </div>
                    </div>
{#                    <div class="col-6">#}
{#                        <div class="card card-body rounded-3 h-100" style="background: var(--sidebar-bg);border: var(--border-width) solid var(--main-content-border-color);">#}
{#                            <h5 class="card-title">Häufigkeit ausgefallener Stunden</h5>#}
{#                            <h6 class="card-subtitle mb-2 tk-text-primary">{{ "first day of this month"|date()|date_modify('-1 month')|format_datetime(date_format='none', time_format='none', locale='de', pattern='MMMM Y') }}</h6>#}
{#                            <div class="ratio ratio-21x9">#}
