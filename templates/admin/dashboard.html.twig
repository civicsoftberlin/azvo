    <script type="module">
        import * as echarts from 'echarts';

        const timeData = {{ stat_ticks|json_encode|raw }};
        const mehrstunden = {{ stat_carryovers|json_encode|raw }};
        const minderstunden = {{ stat_decays|json_encode|raw }};

        const chart = echarts.init(document.getElementById('my-chart'));
        const chart2 = echarts.init(document.getElementById('my-chart-2'));


        chart.setOption({
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    axisLine: { onZero: true },
                    data: timeData,
                    position: 'top'
                },
                {
                    gridIndex: 1,
                    type: 'category',
                    boundaryGap: false,
                    axisLine: { onZero: true },
                    data: timeData,
                    position: 'bottom'
                }
            ],
            yAxis: [
                {
                    name: 'Mehrstunden',
                    type: 'value',
                },
                {
                    gridIndex: 1,
                    name: 'Minderstunden',
                    type: 'value',
                    inverse: true
                }
            ],
            axisPointer: {
                link: [
                    {
                        xAxisIndex: 'all'
                    }
                ]
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    animation: false
                },
                formatter: function (params) {
                    // Sortiere: yAxisIndex 0 (oben/Mehrstunden) zuerst
                    params.sort((a, b) => a.yAxisIndex - b.yAxisIndex);

                    let html = `<div style="font-weight:bold;margin-bottom:6px;">${params[0].axisValue}</div>`;
                    params.forEach(p => {
                        html += `<div style="display:flex;align-items:center;gap:8px;margin:4px 0;">
                <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${p.color};"></span>
                <span>${p.seriesName}</span>
                <span style="margin-left:auto;font-weight:bold;">${p.value}</span>
            </div>`;
                    });
                    return html;
                }
            },
            dataZoom: [
                {
                    show: false,
                    realtime: true,
                    xAxisIndex: [0, 1]
                },
                {
                    type: 'inside',
                    realtime: true,
                    xAxisIndex: [0, 1]
                }
            ],
            grid: [
                {
                    left: 60,
                    right: 50,
                    height: '35%'
                },
                {
                    left: 60,
                    right: 50,
                    top: '55%',
                    height: '35%'
                }
            ],
            series: [
                {
                    name: 'Mehrstunden',
                    type: 'line',
                    symbolSize: 8,
                    data: mehrstunden,
                    color: '#c69c2c'
                },
                {
                    name: 'Minderstunden',
                    type: 'line',
                    xAxisIndex: 1,
                    yAxisIndex: 1,
                    symbolSize: 8,
                    data: minderstunden,
                    color: '#d03148'
                }

            ]
        });

        chart2.setOption({
            xAxis: {
                type: 'category',
                data: ['Verfallen', 'Übertragen'],
                axisTick: {
                    alignWithLabel: true
                }
            },
            yAxis: {
                type: 'value'
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'shadow'
                }
            },
            grid: {
                left: '3%',
                right: '4%',
                bottom: '3%',
                containLabel: true
            },
            series: [
                {
                    data: [
                        {
                            value: {{ stat_real_decays }},
                            itemStyle: {
                                color: '#d03148'
                            }
                        },
                        {
                            value: {{ stat_real_carryovers }},
                            itemStyle: {
                                color: '#c69c2c'
                            }
                        },
                    ],
                    type: 'bar',
                    barWidth: '40%',
                }
            ]
        });

        window.addEventListener('resize', () => chart.resize());
        window.addEventListener('resize', () => chart2.resize());

        document.addEventListener('DOMContentLoaded', () => {
            chart.resize();
            chart2.resize();
        });

        const tab = document.querySelector('#tablist-tab-chart')

        tab.addEventListener('click', event => {
            setTimeout(() => {
                chart.resize();
                chart2.resize();
            }, 0);
        })

    </script>
