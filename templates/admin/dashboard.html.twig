{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Stundenkonten <span class="ms-2 tk-text-primary">{{ "now"|format_datetime(date_format='none', time_format='none', locale='de', pattern='MMMM Y') }}</span>
{% endblock %}

{% block page_actions %}

{% endblock %}


{% block main %}
    <div class="">
        <table id="" class="table table-custom align-middle">
            <thead>
            <tr>
                <th style="width: 100px">ID</th>
                <th style="width: 200px">Lehrkraft</th>
                <th style="width: 200px" class="text-end">Minder-/Mehrstunden</th>
                <th style="width: 200px" class="text-end">Vormonat</th>
                <th style="width: 200px" class="text-end">Auszugleichen</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            {% for teacher in teachers|sort((a, b) => a.countCurrentMonthOvertimeEntries <=> b.countCurrentMonthOvertimeEntries) %}
                {% set diff = teacher.countCurrentMonthOvertimeEntries %}
                {% set filterParams = {
                    'teacher': {
                        'comparison': '=',
                        'value': teacher.id
                    },
                    'incidentDateMonth' : "now"|date('n'),
                    'incidentDateYear' : "now"|date('Y'),
                } %}
                {% set viewUrl = ea_url()
                    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                    .setAction('index')
                    .set('filters', filterParams)
                %}
                {% set detailUrl = ea_url()
                    .setController('App\\Controller\\Admin\\TeacherCrudController')
                    .setAction('detail')
                    .set('entityId', teacher.id)
                %}
                {% set detailUrlB = ea_url()
                    .setController('App\\Controller\\Admin\\TeacherCrudController')
                    .setAction('detail')
                    .set('entityId', teacher.id)
                %}
                {% set exportUrl = ea_url()
                    .setController('App\\Controller\\Admin\\OvertimeEntryCrudController')
                    .setAction('exportExcel')
                    .set('filters', filterParams)
                %}
                {# 2. Klasse basierend auf dem Wert bestimmen #}
                {% set rowClass = diff < 0 ? 'is-critical' : (diff == 0 ? 'is-neutral' : 'is-warning') %}

                <tr class="{{ rowClass }}">
                    <td>{{ teacher.id }}</td>
                    <td class=""><a href="{{ detailUrl }}">{{ teacher.shortName }}</a></td>
                    <td class="text-end">{{ diff }}</td>
                    <td class="text-end text-muted">{{ teacher.countLastMonthOvertimeEntries }}</td>
                    <td class="text-end text-muted">{{ teacher.countCurrentExpiringEntries }}</td>
                    <td class="text-end actions">
                        <a href="{{ detailUrlB }}" class="btn btn-secondary me-3"><i class="ti ti-school tk-text-primary"></i>
                            <span class="btn-label"><span class="action-label">Details</span></span>
                        </a>
                        <a href="{{ viewUrl }}" class="btn btn-secondary"><i class="ti ti-table tk-text-primary"></i>Anzeigen</a>
                        <a href="{{ exportUrl }}" class="btn btn-secondary"><i class="ti ti-table-export text-success"></i>Exportieren</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}


