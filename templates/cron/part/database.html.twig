<div class="list-group list-group-flush">

    <div class="list-groip-item border-bottom mb-3">
        <div class="mb-2">
            <div class="d-flex align-items-center gap-3 mb-2">
                <i class="ti ti-database"></i>
                <div class="tk-text-primary">GPU-Daten importieren</div>
            </div>
            <p class="text-muted small">Kurze Beschreibung, was dieser Prozess genau tut und macht.</p>
        </div>
        <div class="my-2 px-3 rounded-3 code" id="target-gpu">
            <pre><code id="test-target"></code></pre>
        </div>
        <div class="htmx-indicator mb-3" id="indicator-gpu">
            <div class="progress"  role="progressbar" aria-label="Animated striped example" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
            </div>
        </div>
        <div class="actions mb-3">
            <button type="submit" hx-post="{{ path('admin_cron_test') }}"  hx-indicator="#indicator-gpu, #target-gpu"  hx-target="#test-target" class="btn btn-secondary">Prozess starten</button>
        </div>

    </div>

    <div class="list-groip-item">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-3">
                <i class="ti ti-database"></i>
                <div class="tk-text-primary">GPU-Daten importieren</div>
            </div>
        </div>
        <div class="my-2 p-3 rounded-3 code d-none">
            <pre><code class="gpu-result">Ergebnis</code></pre>
        </div>
        <div class="actions mb-3">
            <a href="#" class="btn btn-secondary">Ausführen</a>
        </div>
    </div>

</div>
