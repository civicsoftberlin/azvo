        {{ form_start(form, {
            action: path('admin_report_upload'),
            attr: { enctype: 'multipart/form-data' }
        }) }}
        <div class="form-fieldset field-form_fieldset border-danger">
            <fieldset class="">
                <div class="form-fieldset-header">
                    <div class="form-fieldset-title">
                            <span class="not-collapsible form-fieldset-title-content">
                                <span class="icon form-fieldset-icon"><i class="ti ti-file-type-xls"></i></span>
                                <span class="text-danger">Bestehende Vorlage ersetzen</span>
                            </span>
                    </div>
                </div>
                <div class="form-fieldset-body show">
                    {# start #}
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="">
                            <div class="ea-vich-file">
                                <div class="ea-vich-file-actions">
                                    <div class="btn btn-secondary input-file-container">
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><!--! Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2024 Fonticons, Inc. --><path
                                        d="M246.6 9.4c-12.5-12.5-32.8-12.5-45.3 0l-128 128c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 109.3 192 320c0 17.7 14.3 32 32 32s32-14.3 32-32l0-210.7 73.4 73.4c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-128-128zM64 352c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 64c0 53 43 96 96 96l256 0c53 0 96-43 96-96l0-64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 64c0 17.7-14.3 32-32 32L96 448c-17.7 0-32-14.3-32-32l0-64z"></path></svg>
                            </span>
                                        Datei auswählen
                                        {{ form_widget(form.templateFile) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="report_template_upload_templateFile_new_file_name" class="small mb-3"></div>
                    <div class="row mb-3">
                        <div class="col-xxl-3">{{ form_row(form.until) }}</div>
                    </div>
                    <div class="">
                        <button type="submit" class="btn btn-danger">Hochladen</button>
                    </div>
                    <div class="py-2 small text-danger">
                        Eine neue Vorlage wird erst mit der kommenden Kalenderwoche aktiv.
                    </div>
                </div>
            </fieldset>
        </div>
        {{ form_end(form) }}
    </div>
</div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const fileInput = document.getElementById('report_template_upload_templateFile');
                const fileNameDisplay = document.getElementById('report_template_upload_templateFile_new_file_name');

                if (fileInput && fileNameDisplay) {
                    fileInput.addEventListener('change', function (event) {
                        const file = event.target.files[0];

                        if (file) {
                            // Dateinamen anzeigen
                            fileNameDisplay.textContent = 'Neue Datei: ' + file.name;
                            fileNameDisplay.style.display = 'block';
                            fileNameDisplay.classList.add('mb-3');
                        } else {
                            // Anzeige zurücksetzen, falls Auswahl abgebrochen wurde
                            fileNameDisplay.textContent = '';
                            fileNameDisplay.style.display = 'none';
                        }
                    });
                }
            });
        </script>
        {% endblock %}
