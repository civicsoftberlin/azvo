{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
    Berichte
{% endblock %}

{% block content_title %}
    Berichte
{% endblock %}

{% block page_actions %}

{% endblock %}

{% block main %}
<twig:ea:Tabs>
    <twig:ea:Tabs:Item paneId="tab-report" label="Tagesreport" icon="ti ti-chart-pie-3" active/>
    <twig:ea:Tabs:Item paneId="tab-chart" label="Halbjahre" icon="ti ti-file-type-xls"/>
    <div style="width: 5px; border-left:  var(--border-width) solid var(--form-tabs-border-color)" class="py-3"></div>
    <twig:ea:Tabs:Item paneId="tab-template" label="Vorlage" icon="ti ti-file"/>
</twig:ea:Tabs>

<div class="tab-content">
    <div class="tab-pane active" id="tab-report">
        <div class="list-group list-group-flush">
            <table class="table table-custom datagrid align-middle">
                <thead>
                <tr>
                    <th>Datum</th>
                    <th class="text-end">AU</th>
                    <th class="text-end">Fortblg.</th>
                    <th class="text-end">Veranstlg.</th>
                    <th class="text-end">Sonst. A.</th>
                    <th class="text-end text-black">SUMME A</th>
                    <th class="text-end">Zsmlg.</th>
                    <th class="text-end">Vertr.-Res.</th>
                    <th class="text-end">Mehrarbeit</th>
                    <th class="text-end text-black">SUMME B</th>
                    <th class="text-end text-black fw-bold">A - B</th>
                </tr>
                </thead>
                <tbody>
                {% for item in reports %}
                    <tr>
                        <td>{{ item.DATE|date('d.m.Y') }}</td>
                        <td class="text-end">{{ item.ILL }}</td>
                        <td class="text-end">{{ item.TRAINING }}</td>
                        <td class="text-end">{{ item.EVENT }}</td>
                        <td class="text-end">{{ item.CANCELLED }}</td>
                        <td class="text-end text-black border-start border-end border-3">{{ item.CANCELLED + item.ILL + item.TRAINING + item.EVENT }}</td>
                        <td class="text-end">{{ item.MERGED }}</td>
                        <td class="text-end">{{ item.SUBSTITUTED }}</td>
                        <td class="text-end">{{ item.ADDITIONAL }}</td>
                        <td class="text-end text-black border-start border-end border-3">{{ item.SUBSTITUTED + item.ADDITIONAL + item.MERGED }}</td>
                        <td class="text-end fw-bold">{{ (item.CANCELLED + item.ILL + item.TRAINING + item.EVENT) - (item.SUBSTITUTED + item.ADDITIONAL + item.MERGED) }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center" colspan="8">Keine Einträge vorhanden</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="tab-pane" id="tab-chart">

        <table class="table table-custom datagrid align-middle">
            <thead>
            <tr>
                <th>Bericht</th>
                <th class="text-end">Zuletzt geändert</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            {% for file in files | sort %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-1"><i
                                class="ti ti-file-type-xls text-success fs-5"></i>{{ file.name }}</div>
                    </td>
                    <td class="text-end">{{ file.mtime|date('d.m.Y H:i') }} Uhr</td>
                    <td class="text-end actions"><a href="{{ path('admin_report_export', {'file': file.name }) }}"
                                                    class="btn btn-primary">Download</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="tab-pane" id="tab-template">

        <div class="form-fieldset field-form_fieldset">
            <fieldset class="">
                <div class="form-fieldset-header">
                    <div class="form-fieldset-title">
                            <span class="not-collapsible form-fieldset-title-content">
                                <span class="icon form-fieldset-icon"><i class="ti ti-file-type-xls"></i></span>
                                Aktuelle Vorlage
                            </span>
                    </div>
                </div>
                <div class="form-fieldset-body show">
                    <table class="table table-custom align-middle">
                        <thead>
                        <tr>
                            <th class="">Zuletzt geändert</th>
                            <th class="text-end"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% if template_file %}
                            <tr class="actions">
                                <td class="">{{ template_file.mtime|date('d.m.Y H:i') }} Uhr</td>
                                <td class="text-end actions"><a href="{{ path('admin_report_export', {'file': template_file.name }) }}" class="btn btn-secondary">Download</a></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-center">Keine Datei vorhanden</td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>
                </div>
            </fieldset>
        </div>

